pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Environment to deploy'
        )

        choice(
            name: 'ACTION',
            choices: ['plan', 'initialize', 'apply', 'destroy'],
            description: 'Terraform operation to execute. Default is plan.'
        )
    }

    environment {
        TF_IN_AUTOMATION = 'true'
        TF_INPUT         = 'false'
    }

    stages {

        // =====================================================
        // Verify Jenkins execution environment
        // =====================================================

        stage('Verify Tools') {
            steps {
                sh '''
                    set -e

                    echo "========================================"
                    echo "Jenkins Execution Environment"
                    echo "========================================"

                    echo "User:"
                    whoami

                    echo ""
                    echo "Git:"
                    git --version

                    echo ""
                    echo "Terraform:"
                    terraform version

                    echo ""
                    echo "Azure CLI:"
                    az version

                    echo ""
                    echo "Selected Environment: ${ENVIRONMENT}"
                    echo "Selected Action:      ${ACTION}"
                '''
            }
        }


        // =====================================================
        // Load environment-specific Jenkins properties
        // =====================================================

        stage('Load Environment Properties') {
            steps {
                script {

                    def propertiesFile =
                        "Jenkins/properties/${params.ENVIRONMENT}.properties"

                    echo "Loading properties: ${propertiesFile}"

                    if (!fileExists(propertiesFile)) {
                        error(
                            "Environment properties file not found: ${propertiesFile}"
                        )
                    }

                    // -------------------------------------------------
                    // Load properties
                    // -------------------------------------------------

                    def props = readProperties file: propertiesFile

                    if (!props.ENVIRONMENT) {
                        error(
                            "ENVIRONMENT is not defined in ${propertiesFile}"
                        )
                    }

                    // -------------------------------------------------
                    // Validate selected environment
                    // -------------------------------------------------

                    if (props.ENVIRONMENT != params.ENVIRONMENT) {
                        error(
                            "Environment mismatch: Jenkins selected '${params.ENVIRONMENT}' " +
                            "but properties file declares '${props.ENVIRONMENT}'."
                        )
                    }

                    // -------------------------------------------------
                    // Populate Jenkins environment
                    // -------------------------------------------------

                    env.AZURE_LOCATION =
                        props.AZURE_LOCATION

                    env.PROJECT_NAME =
                        props.PROJECT_NAME

                    env.DEPLOYMENT_ENVIRONMENT =
                        props.ENVIRONMENT

                    env.VNET_ADDRESS_SPACE =
                        props.VNET_ADDRESS_SPACE

                    env.AKS_SUBNET_PREFIX =
                        props.AKS_SUBNET_PREFIX

                    env.PRIVATE_ENDPOINT_SUBNET_PREFIX =
                        props.PRIVATE_ENDPOINT_SUBNET_PREFIX

                    env.AKS_SYSTEM_NODE_VM_SIZE =
                        props.AKS_SYSTEM_NODE_VM_SIZE

                    env.AKS_SYSTEM_NODE_COUNT =
                        props.AKS_SYSTEM_NODE_COUNT

                    env.AKS_USER_NODE_VM_SIZE =
                        props.AKS_USER_NODE_VM_SIZE

                    env.AKS_USER_NODE_COUNT =
                        props.AKS_USER_NODE_COUNT

                    env.ACR_SKU =
                        props.ACR_SKU

                    env.KEY_VAULT_SKU =
                        props.KEY_VAULT_SKU

                    echo "Environment loaded: ${env.DEPLOYMENT_ENVIRONMENT}"
                    echo "Azure location:     ${env.AZURE_LOCATION}"
                    echo "Project:            ${env.PROJECT_NAME}"
                    echo "Terraform action:   ${params.ACTION}"
                }
            }
        }


        // =====================================================
        // Authenticate using Terraform SPN
        // =====================================================

        stage('Azure Authentication') {
            steps {

                withCredentials([

                    string(
                        credentialsId: 'azure-terraform-client-id',
                        variable: 'ARM_CLIENT_ID'
                    ),

                    string(
                        credentialsId: 'azure-terraform-client-secret',
                        variable: 'ARM_CLIENT_SECRET'
                    ),

                    string(
                        credentialsId: 'azure-terraform-tenant-id',
                        variable: 'ARM_TENANT_ID'
                    ),

                    string(
                        credentialsId: 'azure-terraform-subscription-id',
                        variable: 'ARM_SUBSCRIPTION_ID'
                    )

                ]) {

                    sh '''
                        set +x
                        set -e

                        echo "Authenticating Terraform SPN..."

                        az login \
                          --service-principal \
                          --username "$ARM_CLIENT_ID" \
                          --password "$ARM_CLIENT_SECRET" \
                          --tenant "$ARM_TENANT_ID" \
                          --output none

                        az account set \
                          --subscription "$ARM_SUBSCRIPTION_ID"

                        echo "Azure authentication successful."

                        az account show \
                          --query "{Name:name, State:state}" \
                          --output table
                    '''
                }
            }
        }


        // =====================================================
        // Render environment Terraform variables
        // =====================================================

        stage('Render Terraform Variables') {
            steps {

                withCredentials([

                    string(
                        credentialsId: 'azure-terraform-tenant-id',
                        variable: 'ARM_TENANT_ID'
                    ),

                    string(
                        credentialsId: 'azure-terraform-subscription-id',
                        variable: 'ARM_SUBSCRIPTION_ID'
                    )

                ]) {

                    sh '''
                        set +x
                        set -e

                        # -------------------------------------------------
                        # Map Jenkins credentials to template variables
                        # -------------------------------------------------

                        export AZURE_TENANT_ID="$ARM_TENANT_ID"
                        export AZURE_SUBSCRIPTION_ID="$ARM_SUBSCRIPTION_ID"

                        # -------------------------------------------------
                        # Environment selected from Jenkins properties
                        # -------------------------------------------------

                        export ENVIRONMENT="$DEPLOYMENT_ENVIRONMENT"

                        TEMPLATE="variable_templates/${DEPLOYMENT_ENVIRONMENT}.tfvars.tpl"

                        OUTPUT="environments/${DEPLOYMENT_ENVIRONMENT}/${DEPLOYMENT_ENVIRONMENT}.generated.tfvars"

                        echo "========================================"
                        echo "Render Environment Terraform Variables"
                        echo "========================================"

                        echo "Environment: ${DEPLOYMENT_ENVIRONMENT}"
                        echo "Template:    ${TEMPLATE}"
                        echo "Output:      ${OUTPUT}"

                        test -f "$TEMPLATE"

                        mkdir -p "environments/${DEPLOYMENT_ENVIRONMENT}"

                        envsubst < "$TEMPLATE" > "$OUTPUT"

                        test -f "$OUTPUT"

                        echo "Terraform variable file successfully generated."
                    '''
                }
            }
        }


        // =====================================================
        // Verify generated environment configuration
        // =====================================================

        stage('Verify Generated Configuration') {
            steps {
                sh '''
                    set -e

                    GENERATED_FILE="environments/${DEPLOYMENT_ENVIRONMENT}/${DEPLOYMENT_ENVIRONMENT}.generated.tfvars"

                    echo "========================================"
                    echo "Verify Environment Configuration"
                    echo "========================================"

                    echo "Checking generated Terraform configuration:"
                    echo "$GENERATED_FILE"

                    test -f "$GENERATED_FILE"

                    if grep -q '\\${' "$GENERATED_FILE"; then

                        echo "ERROR: Unresolved template variables found."

                        grep '\\${' "$GENERATED_FILE"

                        exit 1
                    fi

                    echo "Generated Terraform configuration validated."
                    echo "No unresolved template variables found."
                '''
            }
        }


        // =====================================================
        // Terraform Format and Validation
        // =====================================================

                // =====================================================
        // Terraform Format Check
        //
        // COMMON STAGE:
        // - Checks Terraform formatting only
        // - Does NOT initialize Terraform
        // - Does NOT plan Terraform
        // - Does NOT apply Terraform
        // - Does NOT destroy Terraform
        //
        // Terraform initialization and validation belong only
        // to the explicit ACTION=initialize lifecycle.
        // =====================================================

        stage('Terraform Format Check') {
            steps {
                sh '''
                    set -e

                    echo "========================================"
                    echo "Terraform Format Check"
                    echo "========================================"

                    ENV_DIR="environments/${DEPLOYMENT_ENVIRONMENT}"

                    echo "Environment: ${DEPLOYMENT_ENVIRONMENT}"
                    echo "Directory:   ${ENV_DIR}"

                    test -d "$ENV_DIR"

                    echo ""
                    echo "Checking Terraform formatting..."

                    terraform fmt -check -recursive

                    echo ""
                    echo "Terraform formatting check completed."

                    echo ""
                    echo "No terraform init was executed."
                    echo "No terraform validate was executed."
                    echo "No terraform plan was executed."
                    echo "No terraform apply was executed."
                    echo "No terraform destroy was executed."
                '''
            }
        }


        // =====================================================
        // Render Bootstrap Terraform Variables
        //
        // Only used when ACTION=initialize
        // =====================================================

        stage('Render Bootstrap Variables') {

            when {
                expression {
                    params.ACTION == 'initialize'
                }
            }

            steps {

                withCredentials([

                    string(
                        credentialsId: 'azure-terraform-subscription-id',
                        variable: 'ARM_SUBSCRIPTION_ID'
                    )

                ]) {

                    sh '''
                        set +x
                        set -e

                        echo "========================================"
                        echo "Render Bootstrap Terraform Variables"
                        echo "========================================"

                        export AZURE_SUBSCRIPTION_ID="$ARM_SUBSCRIPTION_ID"

                        TEMPLATE="variable_templates/bootstrap.tfvars.tpl"
                        OUTPUT="bootstrap/bootstrap.generated.tfvars"

                        echo "Template: ${TEMPLATE}"
                        echo "Output:   ${OUTPUT}"

                        test -f "$TEMPLATE"
                        test -d bootstrap

                        envsubst < "$TEMPLATE" > "$OUTPUT"

                        test -f "$OUTPUT"

                        echo "Bootstrap Terraform variables generated."
                    '''
                }
            }
        }


        // =====================================================
        // Verify Bootstrap Configuration
        //
        // Only used when ACTION=initialize
        // =====================================================

        stage('Verify Bootstrap Configuration') {

            when {
                expression {
                    params.ACTION == 'initialize'
                }
            }

            steps {
                sh '''
                    set -e

                    echo "========================================"
                    echo "Verify Bootstrap Configuration"
                    echo "========================================"

                    GENERATED_FILE="bootstrap/bootstrap.generated.tfvars"

                    echo "Checking generated bootstrap configuration:"
                    echo "$GENERATED_FILE"

                    test -f "$GENERATED_FILE"

                    if grep -q '\\${' "$GENERATED_FILE"; then

                        echo "ERROR: Unresolved bootstrap template variables found."

                        grep '\\${' "$GENERATED_FILE"

                        exit 1
                    fi

                    echo "Bootstrap configuration validated."
                    echo "No unresolved template variables found."
                '''
            }
        }

        // =====================================================
        // Terraform Initialize
        //
        // INITIALIZE CONTRACT:
        // - Initialize ONLY the selected environment
        // - Connect Terraform to the existing Azure backend
        // - Validate the selected environment
        // - NEVER create the backend
        // - NEVER plan infrastructure
        // - NEVER apply infrastructure
        // - NEVER destroy infrastructure
        // =====================================================

        stage('Terraform Initialize') {

            when {
                expression {
                    params.ACTION == 'initialize'
                }
            }

            steps {

                withCredentials([

                    string(
                        credentialsId: 'azure-terraform-client-id',
                        variable: 'ARM_CLIENT_ID'
                    ),

                    string(
                        credentialsId: 'azure-terraform-client-secret',
                        variable: 'ARM_CLIENT_SECRET'
                    ),

                    string(
                        credentialsId: 'azure-terraform-tenant-id',
                        variable: 'ARM_TENANT_ID'
                    ),

                    string(
                        credentialsId: 'azure-terraform-subscription-id',
                        variable: 'ARM_SUBSCRIPTION_ID'
                    )

                ]) {

                    sh '''
                        set +x
                        set -e

                        echo "========================================"
                        echo "Terraform Initialize"
                        echo "========================================"

                        ENV_DIR="environments/${DEPLOYMENT_ENVIRONMENT}"

                        echo ""
                        echo "Environment: ${DEPLOYMENT_ENVIRONMENT}"
                        echo "Directory:   ${ENV_DIR}"

                        # -------------------------------------------------
                        # Verify environment exists
                        # -------------------------------------------------

                        if [ ! -d "$ENV_DIR" ]; then
                            echo ""
                            echo "ERROR: Terraform environment does not exist:"
                            echo "$ENV_DIR"
                            exit 1
                        fi

                        # -------------------------------------------------
                        # Verify generated variables exist
                        # -------------------------------------------------

                        GENERATED_FILE="${ENV_DIR}/${DEPLOYMENT_ENVIRONMENT}.generated.tfvars"

                        if [ ! -f "$GENERATED_FILE" ]; then
                            echo ""
                            echo "ERROR: Generated Terraform variable file not found:"
                            echo "$GENERATED_FILE"
                            exit 1
                        fi

                        # -------------------------------------------------
                        # Initialize selected environment
                        # -------------------------------------------------

                        echo ""
                        echo "Initializing ${DEPLOYMENT_ENVIRONMENT} Terraform..."

                        terraform \
                            -chdir="$ENV_DIR" \
                            init \
                            -reconfigure

                        # -------------------------------------------------
                        # Validate selected environment
                        # -------------------------------------------------

                        echo ""
                        echo "Validating ${DEPLOYMENT_ENVIRONMENT} Terraform..."

                        terraform \
                            -chdir="$ENV_DIR" \
                            validate

                        echo ""
                        echo "========================================"
                        echo "Terraform Initialization Complete"
                        echo "========================================"
                        echo "Environment: ${DEPLOYMENT_ENVIRONMENT}"
                        echo ""
                        echo "NO terraform plan was executed."
                        echo "NO terraform apply was executed."
                        echo "NO terraform destroy was executed."
                        echo "========================================"
                    '''
                }
            }
        }


        // =====================================================
        // PLAN - intentional action only
        // =====================================================
        stage('Environment Plan') {
            when { expression { params.ACTION == 'plan' } }
            steps {
                withCredentials([
                    string(credentialsId: 'azure-terraform-client-id', variable: 'ARM_CLIENT_ID'),
                    string(credentialsId: 'azure-terraform-client-secret', variable: 'ARM_CLIENT_SECRET'),
                    string(credentialsId: 'azure-terraform-tenant-id', variable: 'ARM_TENANT_ID'),
                    string(credentialsId: 'azure-terraform-subscription-id', variable: 'ARM_SUBSCRIPTION_ID')
                ]) {
                    sh '''
                        set +x
                        set -e
                        ENV_DIR="environments/${DEPLOYMENT_ENVIRONMENT}"
                        VAR_FILE="${DEPLOYMENT_ENVIRONMENT}.generated.tfvars"
                        PLAN_FILE="${DEPLOYMENT_ENVIRONMENT}.tfplan"

                        echo "========================================"
                        echo "Terraform Environment Plan"
                        echo "========================================"
                        echo "ACTION=plan selected intentionally."
                        echo "Environment: ${DEPLOYMENT_ENVIRONMENT}"

                        test -d "$ENV_DIR"
                        test -f "$ENV_DIR/$VAR_FILE"

                        if [ ! -d "$ENV_DIR/.terraform" ]; then
                            echo "ERROR: Environment Terraform is not initialized."
                            echo "PLAN will not automatically run initialize."
                            exit 1
                        fi

                        terraform -chdir="$ENV_DIR" plan \
                          -var-file="$VAR_FILE" \
                          -out="$PLAN_FILE"

                        echo "Plan completed. No apply or destroy was executed."
                    '''
                }
            }
        }

        // =====================================================
        // APPLY - intentional action only
        // =====================================================
        stage('Environment Apply') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                withCredentials([
                    string(credentialsId: 'azure-terraform-client-id', variable: 'ARM_CLIENT_ID'),
                    string(credentialsId: 'azure-terraform-client-secret', variable: 'ARM_CLIENT_SECRET'),
                    string(credentialsId: 'azure-terraform-tenant-id', variable: 'ARM_TENANT_ID'),
                    string(credentialsId: 'azure-terraform-subscription-id', variable: 'ARM_SUBSCRIPTION_ID')
                ]) {
                    sh '''
                        set +x
                        set -e
                        ENV_DIR="environments/${DEPLOYMENT_ENVIRONMENT}"
                        PLAN_FILE="${DEPLOYMENT_ENVIRONMENT}.tfplan"

                        echo "========================================"
                        echo "Terraform Environment Apply"
                        echo "========================================"
                        echo "ACTION=apply selected intentionally."
                        echo "Environment: ${DEPLOYMENT_ENVIRONMENT}"

                        test -d "$ENV_DIR"

                        if [ ! -d "$ENV_DIR/.terraform" ]; then
                            echo "ERROR: Environment Terraform is not initialized."
                            echo "APPLY will not automatically run initialize."
                            exit 1
                        fi

                        if [ ! -f "$ENV_DIR/$PLAN_FILE" ]; then
                            echo "ERROR: Saved plan not found: $ENV_DIR/$PLAN_FILE"
                            echo "APPLY will not automatically run plan."
                            exit 1
                        fi

                        terraform -chdir="$ENV_DIR" apply "$PLAN_FILE"
                        echo "Apply completed using the existing saved plan."
                    '''
                }
            }
        }

        // =====================================================
        // DESTROY - intentional action only
        // =====================================================
        stage('Environment Destroy') {
            when { expression { params.ACTION == 'destroy' } }
            steps {
                withCredentials([
                    string(credentialsId: 'azure-terraform-client-id', variable: 'ARM_CLIENT_ID'),
                    string(credentialsId: 'azure-terraform-client-secret', variable: 'ARM_CLIENT_SECRET'),
                    string(credentialsId: 'azure-terraform-tenant-id', variable: 'ARM_TENANT_ID'),
                    string(credentialsId: 'azure-terraform-subscription-id', variable: 'ARM_SUBSCRIPTION_ID')
                ]) {
                    sh '''
                        set +x
                        set -e
                        ENV_DIR="environments/${DEPLOYMENT_ENVIRONMENT}"
                        VAR_FILE="${DEPLOYMENT_ENVIRONMENT}.generated.tfvars"

                        echo "========================================"
                        echo "Terraform Environment Destroy"
                        echo "========================================"
                        echo "ACTION=destroy selected intentionally."
                        echo "Environment: ${DEPLOYMENT_ENVIRONMENT}"

                        test -d "$ENV_DIR"
                        test -f "$ENV_DIR/$VAR_FILE"

                        if [ ! -d "$ENV_DIR/.terraform" ]; then
                            echo "ERROR: Environment Terraform is not initialized."
                            echo "DESTROY will not automatically run initialize."
                            exit 1
                        fi

                        terraform -chdir="$ENV_DIR" destroy \
                          -var-file="$VAR_FILE" \
                          -auto-approve

                        echo "Destroy completed for ${DEPLOYMENT_ENVIRONMENT} only."
                        echo "Bootstrap/state infrastructure was not targeted."
                    '''
                }
            }
        }
    }


    // =========================================================
    // Post Actions - preserve Terraform state and action artifacts
    // =========================================================
    post {
        always {
            sh '''
                echo "========================================"
                echo "Terraform Persistence Policy"
                echo "========================================"
                echo "State files are never deleted."
                echo ".terraform directories are never deleted."
                echo "Saved *.tfplan files are never deleted automatically."
                echo "Generated tfvars are preserved so a later intentional action can reuse them."
                echo "Terraform persistence policy completed."
            '''
        }

        success {
            echo "Jenkins Terraform pipeline completed successfully."
            echo "Environment: ${params.ENVIRONMENT}"
            echo "Action:      ${params.ACTION}"
        }

        failure {
            echo "Jenkins Terraform pipeline failed."
            echo "Environment: ${params.ENVIRONMENT}"
            echo "Action:      ${params.ACTION}"
        }
    }
}
